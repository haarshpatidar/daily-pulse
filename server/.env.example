# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/daily-pulse
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/daily-pulse
MONGO_URI=mongodb://127.0.0.1:27017/daily-pulse

# Express server port (default: 5000)
# PORT=5000

# Assisted apply — Puppeteer browser mode
# false (default): opens a VISIBLE browser window so you can review and submit
# true:            headless mode, for automated/CI testing only (nothing is submitted)
APPLY_HEADLESS=false

# How long (ms) to wait for you to log in to a job platform before timing out
# Default: 180000 (3 minutes)
# APPLY_LOGIN_TIMEOUT_MS=180000
