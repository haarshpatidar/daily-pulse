# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/daily-pulse
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/daily-pulse
MONGO_URI=mongodb://127.0.0.1:27017/daily-pulse

# Express server port (default: 5000)
# PORT=5000

# Assisted apply — Puppeteer browser mode
# false (default): opens a VISIBLE browser window so you can review and submit
# true:            headless mode, for automated/CI testing only (nothing is submitted)
APPLY_HEADLESS=false

# How long (ms) to wait for you to log in to a job platform before timing out
# Default: 180000 (3 minutes)
# APPLY_LOGIN_TIMEOUT_MS=180000

# Automation section — sends application emails (with resume attached) to a
# recipient list you upload.
# REQUIRED: master key encrypting the saved SMTP password at rest.
# Generate one with: openssl rand -base64 32
# Do not rotate once you've saved credentials in Email Settings — re-keying
# existing rows isn't implemented.
APP_ENCRYPTION_KEY=

# Automation behavior
SEND_INTERVAL_MS=8000   # delay between sends (avoid spam flags)
MAX_RETRIES=2           # retries per recipient on failure
DAILY_LIMIT=400         # safety cap per run
